## ╔══════════════════════════════════════════════════════════════╗
## ║   YONBUS — cPanel Production Environment Template           ║
## ║   Copy this file to .env on cPanel via File Manager or SSH  ║
## ║   Replace ALL {{PLACEHOLDER}} values with real cPanel creds  ║
## ╚══════════════════════════════════════════════════════════════╝
##

APP_NAME="YONBUS"
APP_ENV=production
APP_KEY=base64:2LFf20Gy6Hr+yR4yjUzeIb0HRZl8h08kxj6j9TFQXz0=
APP_DEBUG=false
APP_URL=https://yonbustax.ca/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── DATABASE ───────────────────────────────────────────────────
# Find these in cPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yonbgfra_yonbus
DB_USERNAME=yonbgfra_yonbgfra
DB_PASSWORD=yonbgfra_yonbgfra

# ─── SESSION ────────────────────────────────────────────────────
# Uses database — make sure you imported yonbus_export.sql first
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── MAIL (Gmail SMTP via App Password) ─────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yonbustax@gmail.com
MAIL_PASSWORD="ezzy pkcq pvjo sckd"
MAIL_FROM_ADDRESS="yonbustax@gmail.com"
MAIL_FROM_NAME="YONBUS Tax & Accounting"

VITE_APP_NAME="${APP_NAME}"
